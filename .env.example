# Server-only LLM settings for /api/explanations.
# Copy to .env and add the key when ready to enable explanations.
# Never prefix the API key with VITE_: Vite exposes VITE_* values to browsers.
LLM_ENABLED=true
LLM_API_KEY=
LLM_BASE_URL=https://opencode.ai/zen/go/v1
LLM_MODEL=deepseek-v4.1-flash
LLM_TIMEOUT_MS=60000
LLM_MAX_OUTPUT_TOKENS=2500
LLM_DAILY_REQUEST_LIMIT=200

# Optional report chat. It reuses the server-only LLM key and never changes the deterministic scorecard.
LLM_CHAT_ENABLED=true
LLM_CHAT_MAX_OUTPUT_TOKENS=1500
LLM_CHAT_MAX_TURNS=8
LLM_CHAT_DAILY_REQUEST_LIMIT=200
LLM_CHAT_PER_SESSION_LIMIT=12
LLM_CHAT_PER_IP_LIMIT=20

# Optional web research. Every returned web claim is shown with URL, title, retrieval time, and provider.
# OpenCode Go chat completions do not provide this search adapter automatically.
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=tavily
WEB_SEARCH_API_KEY=
TAVILY_API_KEY=
# Use a local endpoint in tests or leave blank for Tavily's production endpoint.
WEB_SEARCH_BASE_URL=
